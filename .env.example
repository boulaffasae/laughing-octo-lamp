# Active server-only OCR provider. Copy to .env.local and supply your Datalab key.
DATALAB_API_KEY=

# LlamaCloud is disabled. Its implementation is retained in lib/ocr/llamacloud.ts.
# LLAMA_CLOUD_API_KEY=

# Optional override for the public production origin, e.g. https://your-domain.ma.
# On Vercel, NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Optional override; the project DSN is configured by default.
NEXT_PUBLIC_SENTRY_DSN=https://695fb9779956b1bedfed218d9e622f7a@o4512345550159872.ingest.de.sentry.io/4512345563856976

# Optional CI source-map uploads (server-only token; never NEXT_PUBLIC).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Private Vercel Blob: connect the store for automatic OIDC, or supply a static token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Neon PostgreSQL connection URL
DATABASE_URL=

# Optional contact address
NEXT_PUBLIC_CONTACT_EMAIL=


# PostHog public project key and regional ingestion URL.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
