{
  "name": "laughing-octo-lamp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "video:preview": "node videos/louma-tiktok/prepare.mjs && hyperframes preview videos/louma-tiktok",
    "video:render": "node videos/louma-tiktok/prepare.mjs && hyperframes render videos/louma-tiktok --output output/video/louma-tiktok-ar.mp4",
    "video:voice": "node videos/louma-tiktok/voiceover.mts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.8",
    "@clerk/nextjs": "^7.10.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@llamaindex/llama-cloud": "^2.19.0",
    "@napi-rs/canvas": "^1.1.1",
    "@neondatabase/serverless": "^1.2.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.10.0",
    "@vercel/blob": "^2.9.0",
    "file-type": "22.2.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pdfjs-dist": "^6.5.438",
    "posthog-js": "^1.450.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "gsap": "3.15.1",
    "hyperframes": "0.9.53",
    "node-edge-tts": "1.2.12",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
